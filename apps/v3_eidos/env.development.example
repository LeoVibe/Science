# 複製為 .env.development（本檔可提交版控；實際密鑰請放 .env.local）
# Vite 載入順序：.env → .env.local → .env.development → .env.development.local（後者覆寫前者）

VITE_APP_BASE=/

# 本機只測 Worker：請指向本機 wrangler（預設 8787）
VITE_API_URL=http://localhost:8787

# 僅在「Google 登入後要打遠端 Worker」時設定；本機只測請勿設或留空
# VITE_API_URL_REMOTE=https://eidos-api.你的網域.workers.dev
