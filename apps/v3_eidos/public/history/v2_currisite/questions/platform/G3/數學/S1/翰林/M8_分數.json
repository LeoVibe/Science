    {
      "id": "4",
      "type": "multiple_choice",
      "question": "下列哪個分數最大？",
      "options": [
        "1/8",
        "1/5",
        "1/10",
        "1/2"
      ],
      "answer": "1/2",
      "explanation": "分子為 1 時，分母越小代表切出的每一塊越大。"
    },
    {
      "id": "5",
      "type": "multiple_choice",
      "question": "吃掉了 3/4 個蛋糕，還剩下幾個？",
      "options": [
        "1/3 個",
        "1/4 個",
        "1 個",
        "全部"
      ],
      "answer": "1/4 個",
      "explanation": "全部為 1 (即 4/4)， 4-3=1，所以剩下 1/4。"
