    "questions": [
        {
            "id": "1",
            "type": "multiple_choice",
            "question": "一個邊長5公分的正方體，其表面積是多少平方公分？",
            "options": [
                "25",
                "125",
                "150",
                "100"
            ],
            "answer": "150",
            "explanation": "一個面的面積為 5×5=25，正方體有6個面，所以 25×6=150。"
        },
        {
            "id": "2",
            "type": "multiple_choice",
            "question": "長6公分、寬4公分、高3公分的長方體表面積是多少？",
            "options": [
                "108",
                "72",
                "92",
                "48"
            ],
            "answer": "108",
            "explanation": "表面積 = (6×4 + 6×3 + 4×3) × 2 = (24 + 18 + 12) × 2 = 54 × 2 = 108。"
        }
    ]
}