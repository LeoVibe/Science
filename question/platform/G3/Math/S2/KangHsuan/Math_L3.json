      "taxonomy": "literal",
      "scenario": "平分披薩情境",
      "question": "一個披薩平分成 8 片，小明吃了 3 片，請問小明吃了幾個披薩？",
      "options": [
        "3/8 個",
        "8/3 個",
        "1/8 個",
        "1/3 個"
      ],
      "answer_index": 0,
      "explanation": "分母代表總平分份數，分子代表持有的份數。",
      "commonMisconception": "學生可能將分子與分母位置寫反（選項 B）。",
      "quality_level": "L4"
    },
    {
      "taxonomy": "inferential",
      "scenario": "同分母分數加法應用",
      "question": "一盒餅乾有 12 片。原本裡面還有 5/12 盒，爸爸又放進去 4/12 盒，現在總共有多少盒餅乾？",
      "options": [
        "9/24 盒",
        "1 盒",
        "9/12 盒",
        "1/12 盒"
      ],
      "answer_index": 2,
      "explanation": "同分母分數相加，分母不變，分子相加。5/12 + 4/12 = 9/12。",
      "commonMisconception": "學生常會連同分母一起相加，得到 9/24（選項 A）。",
      "quality_level": "L3"
    },
    {
      "taxonomy": "applied",
      "scenario": "生活應用：剩下的分數",
      "question": "一條繩子平分成 10 段。小紅拿走 4/10 條，剩下的繩子是多少條？",
      "options": [
        "6/10 條",
        "4/10 條",
        "10/10 條",
        "1 條"
      ],
      "answer_index": 0,
      "explanation": "全部為 10/10 (即 1)。10/10 - 4/10 = 6/10。",
      "commonMisconception": "不知道「全部」可以用分母相同的分數代表（如 10/10）。",
      "quality_level": "L3"
    },
    {
      "taxonomy": "inferential",
      "scenario": "分數大小比較",
      "question": "兩塊同樣大小的蛋糕。一塊切成 5 等份，分給小傑 1 份；另一塊切成 4 等份，分給小英 1 份。誰拿到的蛋糕比較多？",
      "options": [
        "小傑 (1/5)",
        "小英 (1/4)",
        "一樣多",
        "無法判讀"
      ],
      "answer_index": 1,
      "explanation": "單位分數（分子皆為 1）比較時，分母越小則代表每一份切得越大。1/4 > 1/5。",
      "commonMisconception": "直覺認為數字大（5）則越大（選項 A）。",
      "quality_level": "L3"
    },
    {
