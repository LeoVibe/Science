{"kaodian":[{"id":"L6-K01","desc":"里長服務範圍：判斷里長可協助里內公共事務（巡守、弱勢補助、糾紛協調），但不能決定學校事務、個人財務或全國性活動"},{"id":"L6-K02","desc":"社區問題辨識：判斷噪音、垃圾未放指定場所、二手煙、占用公共空間等行為是否造成鄰居困擾"},{"id":"L6-K03","desc":"地方特色產業與故事：藺草帽、苗栗炸龍、臺南鹽水蜂炮、臺東炸寒單、平溪天燈等地方特色配對與故事閱讀"},{"id":"L6-K04","desc":"探究流程：找出事實→說明感受→提出發現→美好未來的順序與各步驟功能辨識"},{"id":"L6-K05","desc":"社區活動性質判斷：區分服務性質活動（掃地、資源回收、關懷獨居老人）與節慶、讀書會等非服務性質活動"},{"id":"L6-K06","desc":"社區共好與多元文化：判斷不同族群、外國人或新住民是否能參與社區活動，重點是包容與共同生活"}],"results":[{"idx":0,"match":false,"kaodian_id":null},{"idx":1,"match":false,"kaodian_id":null},{"idx":2,"match":false,"kaodian_id":null},{"idx":3,"match":false,"kaodian_id":null},{"idx":4,"match":false,"kaodian_id":null},{"idx":5,"match":false,"kaodian_id":null},{"idx":6,"match":false,"kaodian_id":null},{"idx":7,"match":false,"kaodian_id":null},{"idx":8,"match":false,"kaodian_id":null},{"idx":9,"match":false,"kaodian_id":null},{"idx":10,"match":false,"kaodian_id":null},{"idx":11,"match":false,"kaodian_id":null},{"idx":12,"match":false,"kaodian_id":null},{"idx":13,"match":false,"kaodian_id":null},{"idx":14,"match":false,"kaodian_id":null},{"idx":15,"match":false,"kaodian_id":null},{"idx":16,"match":false,"kaodian_id":null},{"idx":17,"match":false,"kaodian_id":null},{"idx":18,"match":false,"kaodian_id":null},{"idx":19,"match":false,"kaodian_id":null},{"idx":20,"match":false,"kaodian_id":null},{"idx":21,"match":false,"kaodian_id":null},{"idx":22,"match":true,"kaodian_id":"L6-K02"},{"idx":23,"match":false,"kaodian_id":null},{"idx":24,"match":false,"kaodian_id":null},{"idx":25,"match":false,"kaodian_id":null},{"idx":26,"match":false,"kaodian_id":null},{"idx":27,"match":false,"kaodian_id":null},{"idx":28,"match":false,"kaodian_id":null},{"idx":29,"match":false,"kaodian_id":null},{"idx":30,"match":false,"kaodian_id":null},{"idx":31,"match":true,"kaodian_id":"L6-K03"},{"idx":32,"match":false,"kaodian_id":null},{"idx":33,"match":true,"kaodian_id":"L6-K03"},{"idx":34,"match":false,"kaodian_id":null},{"idx":35,"match":false,"kaodian_id":null},{