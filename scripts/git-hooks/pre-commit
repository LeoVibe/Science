#!/usr/bin/env bash
# Eidos 專案提交前檢查勾點 (Pre-commit Hook)
# 更新日期：2026-04-27
# ============================================================
# 觸發節點 1：黃金測資（品質評分腳本的回歸測試）
# 觸發節點 2：全站 manifest 格式一致性驗證
# 觸發節點 3：UI ↔ 資料一致性驗證（2026-04-19 加入，防 answer_index 錯位回歸）
# 觸發節點 4：進度檔變更 → progress_sync 自動觸發（2026-04-27 加入）
# ============================================================

echo "=== Eidos 提交前檢查: Git Pre-commit Hook 啟動 ==="

# ── 節點 1：品質評分黃金測試 ──────────────────────────────
# 不論是否修改了評分腳本，每次 commit 均執行，確保評分標準穩定
echo ""
echo ">> [節點 1/4] 執行黃金測資驗證 (evaluate_question_quality.js)..."

if ! node scripts/test_golden_cases.js; then
    echo ""
    echo "❌ [Pre-commit 被拒絕] 黃金單元測試失敗！"
    echo "品質評分標準已被破壞 (改 A 壞 B)，這次提交已被中斷。"
    echo "請修正 scripts/evaluate_question_quality.js 或 tests/golden_cases/ 後重新提交。"
    exit 1
fi
echo "✅ [節點 1/3 通過] 黃金測資驗證通過。"

# ── 節點 2：全站 Manifest 格式一致性驗證 ────────────────────
# 目的：確保任何新增或修改的 manifest.json 嚴格符合
#       唯一格式標準 (items 陣列 + title/file 欄位)
#       若發現違規欄位 (name, units, files, path 等) 即拒絕提交
echo ""
echo ">> [節點 2/4] 執行 manifest 格式一致性驗證..."

# 只在 question/ 或 manifest.json 有異動時才執行，避免非相關改動的過度消耗
if git diff --cached --name-only | grep -q "question/"; then
    if ! node scripts/verify_format_consistency.js; then
        echo ""
        echo "❌ [Pre-commit 被拒絕] Manifest 格式不合規！"
        echo "發現違禁欄位或結構錯誤，請執行 node scripts/normalize_manifest.js 修正後重新提交。"
        exit 1
    fi
    echo "✅ [節點 2/3 通過] Manifest 格式一致性驗證通過。"
else
    echo "   (本次沒有 question/ 的變更，跳過 Manifest 格式驗證)"
fi

# ── 節點 3：UI ↔ 資料一致性驗證 ──────────────────────────────
# 目的：防範 questionLoader 欄位漏讀 / answer_index 錯位（2026-04-19 hotfix 起）
# 檢查開放範圍（G3-G6 × S2）且 is_publishable !== false 的題目
# 若觸動 questionLoader.ts 或題庫 JSON 時必執行
echo ""
echo ">> [節點 3/4] 執行 UI ↔ 資料一致性驗證..."

if git diff --cached --name-only | grep -qE "question/platform/|apps/v3_eidos/src/data/questionLoader|scripts/verify_ui_data_integrity"; then
    if ! node scripts/verify_ui_data_integrity.mjs --gate; then
        echo ""
        echo "❌ [Pre-commit 被拒絕] UI ↔ 資料一致性驗證失敗！"
        echo "題庫資料欄位與前端 loader 解讀不一致，會導致正解位置錯位。"
        echo "請檢查：(1) answer_index 是否為整數且在 options 範圍；"
        echo "        (2) options 是否恰 4 個字串；"
        echo "        (3) questionLoader 是否正確讀取 answer_index 欄位。"
        exit 1
    fi
    echo "✅ [節點 3/3 通過] UI ↔ 資料一致性驗證通過。"
else
    echo "   (本次沒有 question/ 或 questionLoader 相關變更，跳過 UI 一致性驗證)"
fi


# ── 節點 4：進度檔變更 → progress_sync 自動觸發 ──────────────
# 目的：Agent 可能忘記呼叫 progress_sync；此節點偵測 jobs/JOB-*-progress.tsv
#       變更時自動 sync 派工單摘要，並把派工單一起 stage 進入此次 commit
echo ""
echo ">> [節點 4/4] 進度檔變更 → progress_sync 自動觸發..."

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [[ -n "${REPO_ROOT}" && -f "${REPO_ROOT}/scripts/lib/progress_precommit.sh" ]]; then
    # shellcheck disable=SC1091
    source "${REPO_ROOT}/scripts/lib/progress_precommit.sh"
    if ! progress_precommit_run "${REPO_ROOT}"; then
        echo ""
        echo "❌ [Pre-commit 被拒絕] progress_sync 失敗，請檢查派工單與進度檔狀態。"
        exit 1
    fi
    echo "✅ [節點 4/4 通過] 進度檔同步完成。"
else
    echo "   (找不到 scripts/lib/progress_precommit.sh，跳過第 4 節點)"
fi

echo ""
echo "✅ === 所有提交前檢查通過，允許本次 commit ==="
exit 0
